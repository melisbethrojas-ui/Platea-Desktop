<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="500.0" minWidth="600.0" styleClass="desktop-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.CtrlRecintos">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <top>
                <VBox alignment="CENTER" styleClass="top-bar">
                    <padding>
                        <Insets bottom="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="brand-title" text="RECINTES" />
                        <Label styleClass="form-label" text="Gestió de recintes" />
                    </children>
                </VBox>
            </top>

            <center>
                <VBox spacing="15.0" styleClass="content-area">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label fx:id="labelRecinte" styleClass="section-title" text="Recinte1" />
                  <HBox prefHeight="100.0" prefWidth="200.0" spacing="15.0">
                     <children>
                        <Canvas fx:id="canvaRecintes" height="253.0" width="336.0" />
                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="section-title" text="Detall de venda" />
                              <TextArea fx:id="txtDetallVenda" editable="false" prefHeight="230.0" prefWidth="180.0" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                    </children>
                </VBox>
            </center>

            <bottom>
                <HBox alignment="CENTER_RIGHT" styleClass="bottom-bar">
                    <children>
                        <Button onAction="#volverConfiguracion" styleClass="header-button" text="Volver" />
                    </children>
                </HBox>
            </bottom>

        </BorderPane>
    </children>
</AnchorPane>
