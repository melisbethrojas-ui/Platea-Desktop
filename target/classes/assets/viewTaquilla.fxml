<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.CtrlTaquilla"
            minWidth="700.0"
            minHeight="450.0"
            stylesheets="@style.css"
            styleClass="desktop-root">

    <children>

        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT"
                      styleClass="top-bar">

                    <padding>
                        <Insets top="12.0"
                                bottom="12.0"
                                left="20.0"
                                right="20.0"/>
                    </padding>

                    <children>
                        <Label text="Kinese"
                               styleClass="brand-title"/>
                    </children>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true"
                            styleClass="events-scroll">

                    <content>
                        <VBox alignment="TOP_LEFT"
                              spacing="16.0"
                              styleClass="events-content">

                            <padding>
                                <Insets top="22.0"
                                        bottom="22.0"
                                        left="22.0"
                                        right="22.0"/>
                            </padding>

                            <children>
                                <Label text="Esdeveniments disponibles"
                                       styleClass="section-title"/>

                                <VBox fx:id="contenedorEventos"
                                      spacing="14.0"
                                      styleClass="events-list"/>
                            </children>

                        </VBox>
                    </content>
                </ScrollPane>
            </center>

            <bottom>
                <HBox alignment="CENTER_RIGHT"
                      styleClass="bottom-bar">

                    <children>
                        <Button text="Canviar configuració"
                                onAction="#volverConfiguracion"
                                styleClass="header-button"/>
                    </children>
                </HBox>
            </bottom>

        </BorderPane>
    </children>
</AnchorPane>
